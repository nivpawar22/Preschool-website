{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2026-02-21",
  "main": "dist/_worker.js",
  "assets": { "directory": "./dist" },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "superkids-db",
      "database_id": "49487ce4-2d09-4b8a-a473-65ca13227cbc"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "superkidsindiar2bucket"
    }
  ],
  "triggers": {
    // Daily at 3:30 UTC = 9:00am IST — sends fee due-date/overdue email
    // reminders to parents (see runFeeReminders in src/index.tsx).
    "crons": ["30 3 * * *"]
  }
}
